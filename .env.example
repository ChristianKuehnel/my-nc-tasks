# Example environment variables for my-nc-tasks.
# Copy to .env and fill in values. NEVER commit real secrets or credentials.

# Optional: base URL of a Nextcloud server for local development/testing.
# Used only by developer tooling and integration tests; the app itself
# discovers the server through Nextcloud Login Flow v2 at runtime.
NEXTCLOUD_SERVER_URL=

# Optional: name of the test account used against the local test server.
# Passwords are never stored here; use OS keyring or the integration test
# gate's credential provider.
NEXTCLOUD_TEST_USER=

# Expo: enable in CI when a preview build should be uploaded.
# The value is a machine token from https://expo.dev (never commit real values).
# EXPO_TOKEN=
